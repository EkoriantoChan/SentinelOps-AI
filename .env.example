# =============================================================================
# SentinelOps AI - Governed Smart Manufacturing Copilot Environment
# =============================================================================

# Container Image Versions
N8N_VERSION=2.44.7
POSTGRES_VERSION=16.15-alpine

# Timezone Configuration (WIB / UTC+7)
TZ=Asia/Jakarta
PGTZ=Asia/Jakarta
GENERIC_TIMEZONE=Asia/Jakarta

# Task Runner Security
N8N_RUNNERS_AUTH_TOKEN=sentinelops-runners-token-lab

# Port Mapping (Host Ports to Avoid Conflicts)
N8N_HOST_PORT=5690
PG_HOST_PORT=5442
SCADA_HOST_PORT=8085

# PostgreSQL Credentials & Settings
POSTGRES_DB=sentinelops
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=your_secure_postgres_password

# Execution Data Retention
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_ON_PROGRESS=false
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000

# External API Credentials
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
SUPERVISOR_CHAT_ID=1845199518
