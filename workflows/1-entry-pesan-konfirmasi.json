    {
      "parameters": {
        "jsCode": "let audio_base64 = null;\nlet foto_base64 = null;\n\nif ($input.item.binary && $input.item.binary.data) {\n  let b64 = null;\n  try {\n    if (typeof this.helpers?.getBinaryDataBuffer === 'function') {\n      const buf = await this.helpers.getBinaryDataBuffer(0, 'data');\n      if (buf) b64 = buf.toString('base64');\n    }\n  } catch (e) {}\n\n  if (!b64 && $input.item.binary.data.data && $input.item.binary.data.data !== 'filesystem-v2') {\n    b64 = $input.item.binary.data.data;\n  }\n\n  if (!b64 && $input.item.binary.data.id) {\n    try {\n      const fs = require('fs');\n      const relPath = $input.item.binary.data.id.replace(/^filesystem-v2:/, '');\n      const fullPath = '/home/node/.n8n/storage/' + relPath;\n      if (fs.existsSync(fullPath)) {\n        b64 = fs.readFileSync(fullPath).toString('base64');\n      }\n    } catch (e) {}\n  }\n\n  const mime = $input.item.binary.data.mimeType || '';\n  const ext = $input.item.binary.data.fileExtension || '';\n  if (mime.includes('audio') || mime.includes('ogg') || ext === 'oga' || ext === 'ogg') {\n    audio_base64 = b64;\n  } else {\n    foto_base64 = b64;\n  }\n}\n\nlet msg = {};\ntry {\n  msg = $('Telegram Trigger').first().json.message || {};\n} catch (e) {}\n\nconst chat_id = msg.chat ? String(msg.chat.id) : null;\nconst teks = msg.caption || '';\n\nreturn {\n  json: {\n    chat_id,\n    teks,\n    audio_base64,\n    foto_base64,\n    source: 'telegram'\n  }\n};"
      },
