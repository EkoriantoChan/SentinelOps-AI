    {
      "parameters": {
        "jsCode": "const cb = $input.item.json.callback_query;\nconst data = (cb && cb.data) ? cb.data : '';\nconst parts = data.split(':');\nconst decision = parts[0] === 'confirm' ? 'confirm' : (parts[0] === 'cancel' ? 'cancel' : 'unknown');\nconst request_id = parts[1] || '';\nconst chat_id = cb && cb.message && cb.message.chat ? String(cb.message.chat.id) : String(cb.from.id);\nconst callback_query_id = cb.id;\n\nreturn {\n  json: {\n    chat_id,\n    request_id,\n    decision,\n    callback_query_id,\n    source: 'telegram'\n  }\n};"
      },
