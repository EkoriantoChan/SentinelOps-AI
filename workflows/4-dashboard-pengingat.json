          }
        ]
      ]
    },
    "Jalankan Pengingat Sekarang": {
      "main": [
        [
          {
            "node": "Ambil Pengingat Jatuh Tempo",
            "type": "main",
            "index": 0
          },
          {
            "node": "Balas Trigger Reminders",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ambil Pengingat Jatuh Tempo": {
      "main": [
        [
          {
            "node": "Ada Pengingat?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ada Pengingat?": {
      "main": [
        [
          {
